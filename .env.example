# Save as ~/.config/yun-laya/env; chmod 600 that file. Never commit real values.
LAYA_MODEL_DIR=~/.local/share/yun-laya/models/multilingual
# Choose a model actually served by your provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=
# Alternatively, use a locally installed Ollama model:
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=your-installed-model
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=
